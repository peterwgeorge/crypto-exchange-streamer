<Window x:Class="Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Desktop.Converters"
        Title="Crypto Spread Monitor"
        Topmost="True"
        ResizeMode="CanResize"
        Width="420"
        Height="260">

    <Window.Resources>
        <conv:DeltaToBrushConverter x:Key="DeltaBrush"
                                    Deadband="0.01"/>
    </Window.Resources>

    <DockPanel Margin="8">

        <!-- AVG -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding Average, StringFormat=AVG: {0:F2}}"
                   FontSize="14"
                   FontWeight="Bold"
                   Margin="0,6,0,0"/>

        <!-- Controls -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">

            <!-- Weights -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Weights:" Width="70"/>

                <TextBlock Text="CB" Margin="4,0"/>
                <TextBox Width="50"
                         Text="{Binding CoinbaseWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="KR" Margin="8,0"/>
                <TextBox Width="50"
                         Text="{Binding KrakenWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="BN" Margin="8,0"/>
                <TextBox Width="50"
                         Text="{Binding BinanceWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <!-- Offsets -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Offsets:" Width="70"/>

                <TextBlock Text="Global" Margin="4,0"/>
                <TextBox Width="60"
                         Text="{Binding GlobalOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="CB" Margin="8,0"/>
                <TextBox Width="50"
                         Text="{Binding CoinbaseOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="KR" Margin="8,0"/>
                <TextBox Width="50"
                         Text="{Binding KrakenOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="BN" Margin="8,0"/>
                <TextBox Width="50"
                         Text="{Binding BinanceOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="BT" Margin="8,0"/>
                <TextBox Width="50"
                         Text="{Binding BtccOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

        </StackPanel>

        <!-- Data Grid -->
        <DataGrid ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Exchange"
                                    Binding="{Binding Exchange}" />

                <DataGridTextColumn Header="Price"
                                    Binding="{Binding Price, StringFormat=F2}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Δ with coloring -->
                <DataGridTextColumn Header="Δ"
                                    Binding="{Binding Delta, StringFormat=F2}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground"
                                    Value="{Binding Delta,
                                            Converter={StaticResource DeltaBrush}}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- % with coloring -->
                <DataGridTextColumn Header="%"
                                    Binding="{Binding Percent, StringFormat=F3}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Foreground"
                                    Value="{Binding Percent,
                                            Converter={StaticResource DeltaBrush}}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
